 import re as _re
 # The coined characters of 《哥德尔、艾舍尔、巴赫》 (U+AA9E–AAAF, the inverted G at U+E047) come from the ebook's own font in every face.
 STYLE_CSS = _re.sub(r'font-family:(?!"GebRare"|inherit)', 'font-family:"GebRare",', STYLE_CSS)
