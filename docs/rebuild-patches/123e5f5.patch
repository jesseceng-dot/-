+"""Run a build with the running heads fitted to the text block (render.head_fit), the code the layout cache is keyed on
+(book.py among it) left as it was, so every page keeps its lines:  python -m tools.headfit_run tools.bk_build 57"""
+import html
+import re
+import runpy
+import sys
+
+from . import book, render
+
+_furniture = book.BookBuilder.furniture
+
+
+def furniture(self, p, opener):
+    return re.sub(r'(<div class="hd" style="[^"]*">)([^<]*)(</div>)',
+                  lambda m: m.group(1) + html.escape(render.head_fit(html.unescape(m.group(2)))) + m.group(3),
+                  _furniture(self, p, opener))
+
+
+book.BookBuilder.furniture = furniture
+sys.argv = sys.argv[1:]
+runpy.run_module(sys.argv[0], run_name='__main__', alter_sys=True)
