+
+def _apos_ff(m):
+    fams = m.group(1)
+    first = next((f for f in (x.strip().strip('"\'') for x in fams.split(',')) if f not in _APOS_SKIP), '')
+    return f'{m.group(0)};--apos-ff:{fams if first in _APOS_OWN else chr(34) + "AposSerif" + chr(34) + "," + fams}'
