+_APOS_SKIP = {'GrkSerif', 'GebRare', 'HanExt', 'GuaSym', 'DroidHei'}       # (no ’ in these: the next face sets it)
+_APOS_OWN = {'KaiTi', 'ZhengHei', 'LatSerif', 'LatIt', 'Noto Serif', 'AposSerif'}
